# Copy to .env and adjust. Do NOT put tokens here,
# they come from the Keychain via `source scripts/keychain-env.sh`.

# Folder on the Mac that is mounted as /workspace (default: $HOME/dev)
#WORKSPACE_DIR=/Users/you/dev

# UID/GID of the sandbox user (on permission problems with bind mounts use `id -u` / `id -g` on the Mac, usually 501/20)
#SANDBOX_UID=1000
#SANDBOX_GID=1000

# Resources
#SANDBOX_MEM_LIMIT=8g
#SANDBOX_CPUS=4
#SANDBOX_PIDS_LIMIT=2048
#SANDBOX_TMP_SIZE=4g

# mitmweb UI (http://localhost:8081). Empty = random token printed in the proxy log.
#MITMWEB_PORT=8081
#MITMWEB_PASSWORD=

# Optional allowlist, comma-separated. Empty = all hosts allowed (but logged).
#ALLOWED_HOSTS=api.anthropic.com,*.anthropic.com,claude.ai,*.claude.ai,platform.claude.com,*.claude.com,github.com,*.github.com,*.githubusercontent.com,*.githubcopilot.com,registry.npmjs.org,opencode.ai,*.opencode.ai,models.dev,pypi.org,files.pythonhosted.org,proxy.golang.org,sum.golang.org,deb.debian.org

# Save all flows to the mitm-flows volume (1 = on)
#MITM_SAVE_FLOWS=0

# Hosts (regex, comma-separated) that are NOT decrypted (TLS passthrough),
# e.g. a Kubernetes API with client certificates:  MITM_IGNORE_HOSTS=^my-cluster\.example\.com:6443$
#MITM_IGNORE_HOSTS=
